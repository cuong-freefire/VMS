# ============================================
# Backend Server Configuration
# ============================================

# Port cho API server (Express)
PORT_BE=5000

# Port cho Frontend (React)
PORT_FE=3000

# Port cho Swagger UI Documentation server
PORT_SWAGGER=3636

# ============================================
# Database Configuration
# ============================================

# MySQL connection string for Prisma
DATABASE_URL="mysql://root:password@localhost:3306/vms_db"

# ============================================
# Logging Configuration
# ============================================

LOG_LEVEL=debug

# ============================================
# Security & Authentication
# ============================================

SECRET_KEY=your-secret-key-at-least-32-chars-long

# ============================================
# Environment
# ============================================

NODE_ENV=development