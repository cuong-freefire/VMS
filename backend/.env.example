# ============================================
# Backend Server Configuration
# ============================================

# Port cho API server (Express)
# Default: 5000
PORT_BE=5000

# Port cho Frontend (React)
# Default: 3000
# Dùng để cấu hình CORS cho phép requests từ frontend
PORT_FE=3000

# Port cho Swagger UI Documentation server
# Default: 3636
# Server riêng biệt phục vụ API documentation
PORT_SWAGGER=3636

# ============================================
# Logging Configuration
# ============================================

# Log level: debug, info, warn, error, fatal
# - debug: Chi tiết nhất, log mọi thứ (dùng khi dev)
# - info: Thông tin chung, phù hợp production
# - warn: Cảnh báo, lỗi không nghiêm trọng
# - error: Lỗi nghiêm trọng
# Default: info
LOG_LEVEL=debug

# ============================================
# Security & Authentication
# ============================================

# Secret key cho JWT signing
# Sử dụng trong auth.service.js để sign/verify JWT tokens
# WARNING: Trong production, phải dùng strong secret key (tối thiểu 32 ký tự)
# Không được commit lên Git!
SECRET_KEY= "Biến này dành cho secret của token"

# ============================================
# Environment
# ============================================

# Node environment: development, production, test
# - development: Pino pretty logs, detailed errors
# - production: JSON logs, error handling tối ưu
# Default: development
NODE_ENV=development

# ============================================
# Database
# ============================================

# Local MySQL connection for Prisma.
# Fill these placeholders in backend/.env only. Never commit real credentials.
DATABASE_URL="mysql://<MYSQL_USER>:<MYSQL_PASSWORD>@<MYSQL_HOST>:<MYSQL_PORT>/<MYSQL_DATABASE>"

# 2 biến này dùng Gmail Service + NodeMailer để gửi email
SMTP_USER="Biến này là tên tk email đã lấy mk 16 số"
SMTP_PASS="Mật khẩu 16 số của email"

# Biến môi trường cho Cloudinary để lưu trữ ảnh
CLOUDINARY_NAME=""
CLOUDINARY_KEY=""
CLOUDINARY_SECRET=""


