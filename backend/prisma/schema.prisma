// ===== 00-datasource-generator.prisma =====

// ============================================================
// MODULE 00: Datasource & Generator
// ============================================================
// This file defines the Prisma client generator and MySQL
// datasource configuration. Shared by all modules.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== 01-user-auth.prisma =====

// ============================================================
// MODULE 01: User & Authentication
// ============================================================
// Models: Role, User, PasswordResetToken, EmailVerification
// Owner: Member 1 - Authentication & Profile
// ============================================================

// ---- Role ----
model Role {
  roleId      Int      @id @default(autoincrement()) @map("role_id")
  roleName    String   @unique @map("role_name") @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

// ---- User ----
model User {
  userId          Int       @id @default(autoincrement()) @map("user_id")
  email           String    @unique @map("email") @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(255)
  phone           String?   @map("phone") @db.VarChar(20)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(500)
  dateOfBirth     DateTime? @map("date_of_birth")
  gender          String?   @map("gender") @db.VarChar(10)
  address         String?   @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  roleId          Int       @map("role_id")
  organizationId  Int?      @map("organization_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations — these are BACK-REFERENCES from child models (FK on child side)
  role                Role                 @relation(fields: [roleId], references: [roleId])
  organization        Organization?        @relation(fields: [organizationId], references: [organizationId])
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerification[]
  userSkills          UserSkill[]
  createdEvents       Event[]              @relation("EventCreator")
  applications        Application[]
  reviewedApplications Application[]       @relation("ApplicationReviewer")
  attendanceRecords   Attendance[]         @relation("AttendanceTaker")
  attendances         Attendance[]         @relation("Attendee")
  feedbacks           Feedback[]
  certificates        Certificate[]        @relation("CertificateRecipient")
  issuedCertificates  Certificate[]        @relation("CertificateIssuer")
  notificationRecipients NotificationRecipient[]
  sentNotifications      Notification[]        @relation("NotificationSender")
  donations           Donation[]
  paymentTransactions PaymentTransaction[]
  auditLogs           AuditLog[]
  reports             Report[]             @relation("ReportGenerator")

  @@index([roleId])
  @@index([organizationId])
  @@index([email])
  @@index([isActive])
  @@map("users")
}

// ---- Password Reset Token ----
model PasswordResetToken {
  tokenId   Int       @id @default(autoincrement()) @map("token_id")
  userId    Int       @map("user_id")
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// ---- Email Verification ----
model EmailVerification {
  verificationId Int       @id @default(autoincrement()) @map("verification_id")
  userId         Int       @map("user_id")
  token          String    @unique @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at")
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verifications")
}

// ===== 02-organization-category-skill.prisma =====

// ============================================================
// MODULE 02: Organization, Category & Skill
// ============================================================
// Models: Organization, EventCategory, Skill, UserSkill
// Owner: Member 4 - Manager Module
// ============================================================

// ---- Organization ----
model Organization {
  organizationId Int      @id @default(autoincrement()) @map("organization_id")
  name           String   @unique @db.VarChar(255)
  description    String?  @db.Text
  logoUrl        String?  @map("logo_url") @db.VarChar(500)
  website        String?  @db.VarChar(500)
  contactEmail   String?  @map("contact_email") @db.VarChar(255)
  contactPhone   String?  @map("contact_phone") @db.VarChar(20)
  address        String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  users User[]
  events Event[]

  @@index([isActive])
  @@map("organizations")
}

// ---- Event Category ----
model EventCategory {
  categoryId  Int      @id @default(autoincrement()) @map("category_id")
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  events Event[]

  @@index([isActive])
  @@map("event_categories")
}

// ---- Skill ----
model Skill {
  skillId     Int      @id @default(autoincrement()) @map("skill_id")
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userSkills UserSkill[]

  @@index([isActive])
  @@map("skills")
}

// ---- User Skill (Many-to-Many: User <-> Skill) ----
model UserSkill {
  userSkillId     Int      @id @default(autoincrement()) @map("user_skill_id")
  userId          Int      @map("user_id")
  skillId         Int      @map("skill_id")
  proficiencyLevel String? @map("proficiency_level") @db.VarChar(50) // e.g., Beginner, Intermediate, Advanced
  createdAt       DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [skillId], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

// ===== 03-event-management.prisma =====

// ============================================================
// MODULE 03: Event Management
// ============================================================
// Models: Event
// Owner: Member 2 - Volunteer Event Module & Member 3 - Staff Module
// ============================================================

// ---- Event ----
model Event {
  eventId         Int       @id @default(autoincrement()) @map("event_id")
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  location        String?   @db.VarChar(500)
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  registrationDeadline DateTime? @map("registration_deadline")
  maxCapacity     Int       @map("max_capacity")
  approvedParticipants Int  @default(0) @map("approved_participants")
  status          String    @default("Pending") @db.VarChar(50) // Pending, Approved, In Progress, Completed, Cancelled
  bannerUrl       String?   @map("banner_url") @db.VarChar(500)
  isActive        Boolean   @default(true) @map("is_active")
  categoryId      Int?      @map("category_id")
  organizationId  Int?      @map("organization_id")
  createdBy       Int       @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  category    EventCategory? @relation(fields: [categoryId], references: [categoryId])
  organization Organization? @relation(fields: [organizationId], references: [organizationId])
  creator     User           @relation("EventCreator", fields: [createdBy], references: [userId])
  applications Application[]
  attendances  Attendance[]
  feedbacks    Feedback[]
  certificates Certificate[]
  donations    Donation[]

  @@index([status])
  @@index([categoryId])
  @@index([organizationId])
  @@index([createdBy])
  @@index([startDate])
  @@index([isActive])
  @@index([title])
  @@map("events")
}

// ===== 04-application-management.prisma =====

// ============================================================
// MODULE 04: Application Management
// ============================================================
// Models: Application
// Owner: Member 3 - Staff Module (Approve/Reject)
//         Member 2 - Volunteer Event Module (Apply/Cancel)
// ============================================================

// ---- Application ----
model Application {
  applicationId Int      @id @default(autoincrement()) @map("application_id")
  userId        Int      @map("user_id")
  eventId       Int      @map("event_id")
  status        String   @default("Pending") @db.VarChar(50) // Pending, Approved, Rejected, Cancelled
  reviewedBy    Int?     @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  rejectionReason String? @map("rejection_reason") @db.VarChar(500)
  appliedAt     DateTime @default(now()) @map("applied_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user       User        @relation(fields: [userId], references: [userId])
  event      Event       @relation(fields: [eventId], references: [eventId])
  reviewer   User?       @relation("ApplicationReviewer", fields: [reviewedBy], references: [userId])
  attendances Attendance[]

  @@unique([userId, eventId]) // One application per volunteer per event
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([reviewedBy])
  @@map("applications")
}

// ===== 05-attendance-management.prisma =====

// ============================================================
// MODULE 05: Attendance Management
// ============================================================
// Models: Attendance
// Owner: Member 3 - Staff Module
//         Member 2 - Volunteer Event Module (history view)
// ============================================================

// ---- Attendance ----
model Attendance {
  attendanceId  Int      @id @default(autoincrement()) @map("attendance_id")
  applicationId Int      @map("application_id")
  eventId       Int      @map("event_id")
  userId        Int      @map("user_id")
  status        String   @default("Present") @db.VarChar(20) // Present, Absent
  checkInTime   DateTime @default(now()) @map("check_in_time")
  checkedBy     Int      @map("checked_by")
  notes         String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  application Application @relation(fields: [applicationId], references: [applicationId])
  event       Event       @relation(fields: [eventId], references: [eventId])
  user        User        @relation("Attendee", fields: [userId], references: [userId])
  checker     User        @relation("AttendanceTaker", fields: [checkedBy], references: [userId])

  @@unique([applicationId]) // One attendance record per application
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@map("attendances")
}

// ===== 06-feedback-management.prisma =====

// ============================================================
// MODULE 06: Feedback Management
// ============================================================
// Models: Feedback
// Owner: Member 2 - Volunteer Event Module (submit feedback)
//         Member 3 - Staff Module (view feedback list)
// ============================================================

// ---- Feedback ----
model Feedback {
  feedbackId  Int      @id @default(autoincrement()) @map("feedback_id")
  userId      Int      @map("user_id")
  eventId     Int      @map("event_id")
  rating      Int      @map("rating") // 1-5 star rating
  comment     String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user  User  @relation(fields: [userId], references: [userId])
  event Event @relation(fields: [eventId], references: [eventId])

  @@unique([userId, eventId]) // One feedback per volunteer per event
  @@index([userId])
  @@index([eventId])
  @@index([rating])
  @@map("feedbacks")
}

// ===== 07-certificate-management.prisma =====

// ============================================================
// MODULE 07: Certificate Management
// ============================================================
// Models: Certificate
// Owner: Member 3 - Staff Module (generate)
//         Member 2 - Volunteer Event Module (view/download)
// ============================================================

// ---- Certificate ----
model Certificate {
  certificateId   Int      @id @default(autoincrement()) @map("certificate_id")
  userId          Int      @map("user_id")
  eventId         Int      @map("event_id")
  certificateUrl  String   @map("certificate_url") @db.VarChar(500)
  issuedBy        Int      @map("issued_by")
  issuedAt        DateTime @default(now()) @map("issued_at")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user   User @relation("CertificateRecipient", fields: [userId], references: [userId])
  event  Event @relation(fields: [eventId], references: [eventId])
  issuer User @relation("CertificateIssuer", fields: [issuedBy], references: [userId])

  @@unique([userId, eventId]) // One certificate per volunteer per event
  @@index([userId])
  @@index([eventId])
  @@index([issuedBy])
  @@map("certificates")
}

// ===== 08-notification-management.prisma =====

// ============================================================
// MODULE 08: Notification Management
// ============================================================
// Models: Notification, NotificationRecipient
// Owner: Member 5 - Admin Module
// ============================================================

// ---- Notification ----
model Notification {
  notificationId Int      @id @default(autoincrement()) @map("notification_id")
  title          String   @db.VarChar(255)
  message        String?  @db.Text
  type           String   @default("System") @db.VarChar(50) // System, Event, Application, Certificate
  referenceId    Int?     @map("reference_id") // ID of related entity (event, application, etc.)
  referenceType  String?  @map("reference_type") @db.VarChar(50) // Entity type: event, application, etc.
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  sender              User                   @relation("NotificationSender", fields: [createdBy], references: [userId])
  notificationRecipients NotificationRecipient[]

  @@index([createdBy])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// ---- Notification Recipient (Many-to-Many: Notification <-> User) ----
model NotificationRecipient {
  notificationRecipientId Int      @id @default(autoincrement()) @map("notification_recipient_id")
  notificationId          Int      @map("notification_id")
  userId                  Int      @map("user_id")
  isRead                  Boolean  @default(false) @map("is_read")
  readAt                  DateTime? @map("read_at")
  createdAt               DateTime @default(now()) @map("created_at")

  // Relations
  notification Notification @relation(fields: [notificationId], references: [notificationId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [userId])

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
  @@index([isRead])
  @@map("notification_recipients")
}

// ===== 09-donation-payment.prisma =====

// ============================================================
// MODULE 09: Donation & Payment Gateway
// ============================================================
// Models: Donation, PaymentTransaction
// Owner: Member 5 - Admin Module (view donation history)
// ============================================================

// ---- Donation ----
model Donation {
  donationId    Int      @id @default(autoincrement()) @map("donation_id")
  userId        Int      @map("user_id")
  eventId       Int      @map("event_id")
  amount        Decimal  @map("amount") @db.Decimal(15, 0) // VND amount (no decimals)
  message       String?  @db.VarChar(500)
  status        String   @default("Pending") @db.VarChar(50) // Pending, Success, Failed, Cancelled
  donatedAt     DateTime @default(now()) @map("donated_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user  User  @relation(fields: [userId], references: [userId])
  event Event @relation(fields: [eventId], references: [eventId])

  paymentTransactions PaymentTransaction[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("donations")
}

// ---- Payment Transaction ----
model PaymentTransaction {
  transactionId   Int      @id @default(autoincrement()) @map("transaction_id")
  donationId      Int      @map("donation_id")
  userId          Int      @map("user_id")
  amount          Decimal  @map("amount") @db.Decimal(15, 0)
  paymentMethod   String   @map("payment_method") @db.VarChar(50) // VNPay, MoMo
  transactionRef  String   @unique @map("transaction_ref") @db.VarChar(255) // External gateway reference
  gatewayResponse String?  @map("gateway_response") @db.Text // Raw response from payment gateway
  status          String   @default("Pending") @db.VarChar(50) // Pending, Success, Failed, Cancelled
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  donation Donation @relation(fields: [donationId], references: [donationId])
  user     User     @relation(fields: [userId], references: [userId])

  @@index([donationId])
  @@index([userId])
  @@index([transactionRef])
  @@index([status])
  @@map("payment_transactions")
}

// ===== 10-audit-reporting.prisma =====

// ============================================================
// MODULE 10: Audit & Reporting
// ============================================================
// Models: AuditLog, Report
// Owner: Member 5 - Admin Module (dashboard, statistics, export)
// ============================================================

// ---- Audit Log ----
model AuditLog {
  auditLogId  Int      @id @default(autoincrement()) @map("audit_log_id")
  userId      Int      @map("user_id")
  action      String   @db.VarChar(100) // e.g., APPROVE_APPLICATION, CREATE_EVENT, GENERATE_CERTIFICATE
  entityType  String   @map("entity_type") @db.VarChar(100) // e.g., application, event, certificate
  entityId    Int      @map("entity_id")
  oldValue    String?  @map("old_value") @db.Text // JSON snapshot before change
  newValue    String?  @map("new_value") @db.Text // JSON snapshot after change
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---- Report ----
model Report {
  reportId    Int      @id @default(autoincrement()) @map("report_id")
  title       String   @db.VarChar(255)
  type        String   @db.VarChar(50) // Event, Volunteer, Donation, System
  parameters  String?  @db.Text // JSON: filter criteria used to generate report
  fileUrl     String?  @map("file_url") @db.VarChar(500) // URL of exported file (PDF, Excel)
  format      String?  @db.VarChar(20) // pdf, excel, csv
  generatedBy Int      @map("generated_by")
  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  generator User @relation("ReportGenerator", fields: [generatedBy], references: [userId])

  @@index([type])
  @@index([generatedBy])
  @@index([generatedAt])
  @@map("reports")
}
