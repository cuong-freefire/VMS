// Prisma Schema for Volunteer Management System (VMS)
// Version: 3.0 (Reduced Scope - 2 Members)
// Last Updated: 2026-07-15
// Scope: Volunteer, Staff, Manager, Admin
// Modules removed: Organization, Attendance, Certificate, Feedback, Notification, Donation, Payment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  VOLUNTEER
  STAFF
  MANAGER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EventCategoryType {
  LOCATION
  TIME
  TYPE
}

enum EmailVerificationType {
  REGISTER
  RESET_PASSWORD
}

// ============================================================================
// 1. Authentication & User Management
// ============================================================================

/// Định nghĩa các vai trò trong hệ thống
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

/// Lưu trữ tài khoản người dùng
/// Soft Delete: Yes (is_active)
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255) @map("password_hash")
  fullName      String   @db.VarChar(255) @map("full_name")
  phone         String?  @db.VarChar(20)
  avatarUrl     String?  @db.VarChar(500) @map("avatar_url")
  roleId        Int      @map("role_id")
  isActive      Boolean  @default(true) @map("is_active")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  role                  Role          @relation(fields: [roleId], references: [id])
  session               UserSession?
  applicationsSubmitted Application[] @relation("applicationSubmittedByUser")
  applicationsProcessed Application[] @relation("applicationProcessedByUser")
  userSkills            UserSkill[]
  eventsCreated         Event[]       @relation("createdByStaff")
  eventsApproved        Event[]       @relation("approvedByManager")
  eventsRejected Event[] @relation("rejectedByManager")

  @@index([roleId])
  @@index([isActive])
  @@index([emailVerified])
  @@map("users")
}

/// Single Active Session enforcement (JWT jti tracking)
model UserSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  jti       String   @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jti])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Account lockout tracking (brute-force protection)
/// Note: NO foreign key constraint - tracks email regardless of user existence (prevents user enumeration)
model LoginAttempt {
  id          Int       @id @default(autoincrement())
  email       String    @unique @db.VarChar(255)
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([lockedUntil])
  @@map("login_attempts")
}

/// Email verification tokens & Password reset OTP
model EmailVerification {
  id          Int                   @id @default(autoincrement())
  email       String                @db.VarChar(255)
  otpHash     String                @db.VarChar(255) @map("otp_hash")
  type        EmailVerificationType @default(REGISTER)
  createdAt   DateTime              @default(now()) @map("created_at")
  lastSentAt  DateTime?             @map("last_sent_at")
  attempts    Int                   @default(0)
  isLocked    Boolean               @default(false) @map("is_locked")
  lockedUntil DateTime?             @map("locked_until")

  @@unique([email, type])
  @@index([email])
  @@index([createdAt])
  @@index([lockedUntil])
  @@map("email_verifications")
}

// ============================================================================
// 2. Skills Management
// ============================================================================

/// Danh mục kỹ năng tình nguyện
/// Soft Delete: Yes (is_active)
model Skill {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userSkills UserSkill[]

  @@index([isActive])
  @@map("skills")
}

/// Many-to-many: Users ↔ Skills
model UserSkill {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  skillId   Int      @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

// ============================================================================
// 3. Events & Categories
// ============================================================================

/// Phân loại sự kiện (Location, Time, Type)
/// Soft Delete: Yes (is_active)
model EventCategory {
  id           Int               @id @default(autoincrement())
  name         String            @db.VarChar(255)
  categoryType EventCategoryType @map("category_type")
  description  String?           @db.Text
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  events Event[]

  @@unique([name, categoryType])
  @@index([categoryType, isActive])
  @@map("event_categories")
}

/// Sự kiện tình nguyện
/// Soft Delete: Yes (is_active)
model Event {
  id                   Int         @id @default(autoincrement())
  title                String      @db.VarChar(500)
  description          String      @db.Text
  location             String      @db.VarChar(500)
  startDate            DateTime    @map("start_date")
  endDate              DateTime    @map("end_date")
  applicationDeadline  DateTime    @map("application_deadline")
  maxCapacity          Int         @map("max_capacity")
  approvedParticipants Int         @default(0) @map("approved_participants")
  imageUrl             String?     @db.VarChar(500) @map("image_url")
  categoryId           Int         @map("category_id")
  createdBy            Int         @map("created_by")
  approvedBy           Int?        @map("approved_by")
  approvedAt           DateTime?   @map("approved_at")
  rejectedBy           Int?        @map("rejected_by")
  rejectedAt           DateTime?   @map("rejected_at")
  rejectedReason       String?     @db.Text @map("rejected_reason")
  status               EventStatus @default(DRAFT)
  isActive             Boolean     @default(true) @map("is_active")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  category       EventCategory @relation(fields: [categoryId], references: [id])
  createdByUser  User          @relation("createdByStaff", fields: [createdBy], references: [id])
  approvedByUser User?         @relation("approvedByManager", fields: [approvedBy], references: [id])
  rejectedByUser User?         @relation("rejectedByManager", fields: [rejectedBy], references: [id])
  applications   Application[]

  @@index([categoryId])
  @@index([createdBy])
  @@index([approvedBy])
  @@index([rejectedBy])
  @@index([status, isActive])
  @@index([startDate])
  @@index([applicationDeadline])
  @@index([categoryId, status, isActive, startDate])
  @@map("events")
}

// ============================================================================
// 4. Applications
// ============================================================================

/// Đơn đăng ký tham gia sự kiện
model Application {
  id          Int               @id @default(autoincrement())
  userId      Int               @map("user_id")
  eventId     Int               @map("event_id")
  status      ApplicationStatus @default(PENDING)
  message     String?           @db.Text
  processedBy Int?              @map("processed_by")
  processedAt DateTime?         @map("processed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  submittedByUser User  @relation("applicationSubmittedByUser", fields: [userId], references: [id])
  event           Event @relation(fields: [eventId], references: [id])
  processedByUser User? @relation("applicationProcessedByUser", fields: [processedBy], references: [id])

  @@index([userId, status])
  @@index([eventId, status])
  @@index([processedBy])
  @@map("applications")
}